{
  "name": "arkafund-dapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:release": "npm run test:release-gate && npm run build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "audit:prod": "node ./scripts/production_dependency_audit.mjs",
    "release:gate": "npm run audit:prod && npm run test:release-gate && npm run build",
    "test:release-gate": "vitest run --environment node tests/unit/production-environment-gate.test.ts tests/unit/testnet-dress-rehearsal.test.ts tests/integration/api-release-gate-route.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1 --testTimeout=30000 --hookTimeout=30000",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-https://app.arka.fund} playwright test e2e/production-public.spec.ts --project=chromium --workers=1",
    "e2e:prep": "bash ./scripts/e2e_prep.sh",
    "test:e2e:live-testnet": "E2E_ALLOW_TESTNET_MUTATIONS=1 npm run e2e:prep && E2E_ALLOW_TESTNET_MUTATIONS=1 playwright test e2e/wallet-backed.spec.ts --project=chromium --workers=1",
    "e2e": "npm run test:e2e",
    "contracts:extend-storage": "node ./scripts/contracts_storage_extend.mjs --dry-run",
    "testnet:rehearsal": "node ./scripts/verify_testnet_dress_rehearsal.mjs",
    "testnet:rehearsal:json": "node ./scripts/verify_testnet_dress_rehearsal.mjs --json",
    "design:audit": "playwright test e2e/design-audit.spec.ts && node ./scripts/render_design_audit_report.mjs",
    "design:audit:pixel": "npm run design:audit && python3 ./scripts/figma_pixel_audit.py",
    "design:audit:pixel:strict": "npm run design:audit && python3 ./scripts/figma_pixel_audit.py --strict",
    "docs:screenshots": "playwright test e2e/design-audit.spec.ts --project=chromium --workers=1",
    "docs:platform-manual": "node ./scripts/generate_platform_manual.mjs",
    "docs:platform-manual:check": "node ./scripts/generate_platform_manual.mjs --check",
    "docs:platform-final": "npm run docs:screenshots && npm run docs:platform-manual:check",
    "demo:tour": "DEMO_TOUR_ONLY=1 DEMO_OUTPUT_STEM=platform-tour-full node ./scripts/record_demo.mjs",
    "demo:video": "node ./scripts/record_demo.mjs",
    "demo:render": "node ./scripts/render_demo.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "file:vendor/stellar-wallets-kit",
    "@sodax/swaps-api": "2.1.0",
    "@sodax/types": "2.1.0",
    "@stellar/freighter-api": "^5.0.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@cosmjs/tendermint-rpc": "0.39.0",
    "@injectivelabs/sdk-ts": "1.19.14",
    "@injectivelabs/wallet-base": "1.19.14",
    "@injectivelabs/wallet-core": "1.19.14",
    "@json-rpc-tools/provider": "1.7.6",
    "@mysten/sui": "1.45.2",
    "@mysten/wallet-standard": "0.20.3",
    "@walletconnect/core": "2.23.9",
    "@walletconnect/sign-client": "2.23.9",
    "@walletconnect/universal-provider": "2.23.9",
    "@walletconnect/utils": "2.23.9",
    "axios": "1.21.0",
    "bn.js": "5.2.3",
    "defu": "6.1.7",
    "eip1193-provider": "1.0.1",
    "ethers": "6.16.0",
    "follow-redirects": "1.16.2",
    "h3": "1.15.11",
    "ip-address": "10.7.5",
    "jws": "4.0.1",
    "nanoid": "3.3.18",
    "picomatch": "4.0.4",
    "postcss": "8.5.26",
    "form-data": "4.0.6",
    "protobufjs": "8.8.1",
    "sharp": "0.35.5",
    "toml": "5.0.1",
    "valibot": "1.4.2",
    "viem": "2.50.4",
    "ws": "8.21.0",
    "eslint-config-next": {
      "@typescript-eslint/parser": "8.72.3-alpha.3",
      "@typescript-eslint/eslint-plugin": "8.72.3-alpha.3"
    }
  }
}
